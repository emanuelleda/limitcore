# No secrets in this file. Copy to deploy/vps/.env (ignored by git).
# Replace the digest with the REAL digest of a successfully published GHCR image.
LIMITCORE_IMAGE=ghcr.io/emanuelleda/limitcore@sha256:REPLACE_WITH_REAL_64_HEX_DIGEST
# Redis MUST already exist, with TLS and authentication. Do not use localhost.
LIMITCORE_REDIS_HOST=redis.example.internal
LIMITCORE_REDIS_PORT=6380
LIMITCORE_REDIS_USERNAME=
# These secret files should live OUTSIDE the git checkout.
LIMITCORE_TENANTS_FILE=/absolute/path/to/private/tenants
LIMITCORE_REDIS_PASSWORD_FILE=/absolute/path/to/private/redis-password
# Exposed only on loopback, NOT directly to the public Internet.
LIMITCORE_LOCAL_PORT=18080
LIMITCORE_ALGORITHM=token-bucket
LIMITCORE_CAPACITY=100
LIMITCORE_WINDOW_SECONDS=60
LIMITCORE_MAX_ACTIVE_KEYS=1000
